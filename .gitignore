# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets are never committed, but the template is,
# so a reviewer can see exactly what configuration the app requires.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma client is generated code — regenerated on every install via the
# "postinstall" script, so it must not be committed.
/src/generated/

# Personal study notes - kept local, not part of the submission
NOTES.md

# Auto-generated by `next dev` on every run - editor/agent config, not project code
AGENTS.md
CLAUDE.md

# Session state file - local only, never committed
PROJECT_STATE.md

# Prep and working files - local only, never part of the submission
COMMITS.md
INTERVIEW.md
LOOM_SCRIPT.md
