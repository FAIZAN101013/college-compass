# Copy this file to .env and fill in real values.
# .env is gitignored; this template is committed so reviewers and future
# contributors know exactly what configuration the app needs to boot.

# ---------------------------------------------------------------------------
# PostgreSQL connection string.
#
# Neon (what this project deploys against): create a project at neon.tech and
# copy the POOLED connection string — the host contains "-pooler". Serverless
# functions scale to many short-lived instances, and the pooled endpoint is
# what stops them from exhausting the database connection limit.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Secret used to sign session JWTs. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
#
# Use a DIFFERENT value in production than in development. Rotating this
# value invalidates every existing session, which is the intended behaviour
# if the secret is ever leaked.
# ---------------------------------------------------------------------------
JWT_SECRET="generate-a-random-32-plus-character-string-here"
